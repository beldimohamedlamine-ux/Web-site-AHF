# AHF CONSULTING â€” en-tÃªtes de sÃ©curitÃ© (Apache 2.4+ avec mod_headers)
# Ã€ placer Ã  la racine du site (mÃªme dossier que index.html).
# DÃ©commentez la section HTTPS si vous servez le site uniquement en HTTPS.

<IfModule mod_headers.c>
  # Ne pas deviner le type MIME (rÃ©duit certains risques XSS)
  Header set X-Content-Type-Options "nosniff"
  # Ancien navigateurs sans CSP frame-ancestors
  Header set X-Frame-Options "DENY"
  # Politique de rÃ©fÃ©rent (alignÃ©e avec la balise meta)
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # CapacitÃ©s navigateur dÃ©sactivÃ©es (alignÃ© avec Permissions-Policy meta)
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  # MÃªme CSP que dans les pages HTML (Ã©vite un seul des deux si vous supprimez la meta plus tard)
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://formspree.io; frame-src 'self' https://www.google.com https://maps.google.com; upgrade-insecure-requests"

  # DÃ©commenter une fois le site servi UNIQUEMENT en HTTPS (sinon risque pour les visiteurs en HTTP)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Pas de listage des dossiers
Options -Indexes

# Bloquer lâ€™accÃ¨s aux chemins cachÃ©s type /.git/ (sauf /.well-known/ pour SSL / Letâ€™s Encrypt)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Permet les URLs sans extension (.html), ex: /ar/contact -> /ar/contact.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]
</IfModule>

